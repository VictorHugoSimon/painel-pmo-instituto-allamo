{
  "name": "allamo-pmo",
  "private": true,
  "scripts": {
    "build:work": "node scripts/build-work-management.mjs",
    "dev": "npm run build:work && wrangler pages dev public",
    "deploy:stage": "npm run build:work && wrangler pages deploy public --project-name allamo-pmo-stage --branch production",
    "deploy:prod": "npm run build:work && wrangler pages deploy public --project-name allamo-pmo --branch main",
    "db:stage:work": "wrangler d1 execute allamo-pmo-stage --remote --file=./migration-work-management-fase1.sql",
    "db:prod:work": "wrangler d1 execute allamo-pmo --remote --file=./migration-work-management-fase1.sql",
    "test:work:stage": "node test/work-management-smoke.mjs https://allamo-pmo-stage.pages.dev",
    "test:work:prod": "node test/work-management-smoke.mjs https://allamo-pmo.pages.dev",
    "db:init": "wrangler d1 execute allamo-pmo --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute allamo-pmo --remote --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
